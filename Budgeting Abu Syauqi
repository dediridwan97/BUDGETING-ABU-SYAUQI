    // =========================================================================
    // 2. FUNGSI HELPER FORMAT, UTILITAS & UI (TOAST, LOADER, BOTTOM SHEET)
    // =========================================================================
    function formatRp(num) {
      const n = Number(num) || 0;
      const absStr = Math.round(Math.abs(n)).toLocaleString("id-ID");
      return (n < 0 ? "-Rp " : "Rp ") + absStr;
    }

    function formatShortRp(num) {
      const n = Number(num) || 0;
      const sign = n < 0 ? "-" : "";
      const abs = Math.abs(n);
      if (abs >= 1000000000) return sign + (abs / 1000000000).toFixed(1) + "M";
      if (abs >= 1000000) return sign + (abs / 1000000).toFixed(1) + "jt";
      if (abs >= 1000) return sign + Math.round(abs / 1000) + "rb";
      return sign + Math.round(abs);
    }

    // Format angka dengan pemisah ribuan tanda koma (contoh: 1,500,000)
    function formatNumberComma(val) {
      if (val === "" || val === null || val === undefined) return "";
      const digits = String(val).replace(/[^\d]/g, "");
      if (!digits) return "";
      return Number(digits).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    // Ambil nilai angka murni dari input yang berisi tanda koma
    function parseNominal(val) {
      const digits = String(val == null ? "" : val).replace(/[^\d]/g, "");
      return digits ? Number(digits) : 0;
    }

    // Handler oninput untuk memformat koma otomatis sambil menjaga posisi kursor
    function formatNominalInput(el) {
      const start = el.selectionStart || 0;
      const oldLen = el.value.length;
      const formatted = formatNumberComma(el.value);
      el.value = formatted;
      const newLen = formatted.length;
      const nextPos = Math.max(0, start + (newLen - oldLen));
      try { el.setSelectionRange(nextPos, nextPos); } catch (e) {}
    }

    function escapeHtml(str) {
      return String(str == null ? "" : str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function pad2(n) {
      return String(n).padStart(2, "0");
    }

    function getBulanTahunKey(year, monthIdx) {
      return year + "-" + pad2(monthIdx + 1);
    }

    function getPrevMonthYear(year, monthIdx) {
      if (monthIdx === 0) return { year: year - 1, month: 11 };
      return { year: year, month: monthIdx - 1 };
    }

    function formatDateIndo(iso) {
      if (!iso) return "-";
      const p = String(iso).split("-");
      if (p.length !== 3) return iso;
      const m = Number(p[1]) - 1;
      return Number(p[2]) + " " + (BULAN_LIST[m] ? BULAN_LIST[m].slice(0, 3) : p[1]) + " " + p[0];
    }

    function genId(prefix) {
      return prefix + "-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 6).toUpperCase();
    }

    function getPosBadgeClass(pos) {
      if (pos === "Kebutuhan") return "bg-rose-100 text-rose-700 border-rose-200";
      if (pos === "Keinginan") return "bg-amber-100 text-amber-800 border-amber-200";
      if (pos === "Investasi") return "bg-teal-100 text-teal-800 border-teal-200";
      return "bg-slate-100 text-slate-600 border-slate-200";
    }

    function showLoader(show) {
      const el = document.getElementById("global-loader");
      if (!el) return;
      el.classList.toggle("hidden", !show);
    }

    function showToast(message, type) {
      const container = document.getElementById("toast-container");
      if (!container) return;
      const t = type || "success";
      const colors = {
        success: "bg-emerald-700 text-white",
        error: "bg-rose-600 text-white",
        warning: "bg-amber-500 text-white",
        info: "bg-slate-800 text-white"
      };
      const icons = {
        success: "fa-circle-check",
        error: "fa-circle-xmark",
        warning: "fa-triangle-exclamation",
        info: "fa-circle-info"
      };
      const el = document.createElement("div");
      el.className = "pointer-events-auto flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl shadow-lg text-xs font-bold animate-fade " + (colors[t] || colors.info);
      el.innerHTML = '<i class="fa-solid ' + (icons[t] || icons.info) + ' text-sm shrink-0"></i><span class="leading-snug">' + escapeHtml(message) + '</span>';
      container.appendChild(el);
      setTimeout(function() {
        el.style.opacity = "0";
        el.style.transition = "opacity 0.25s ease";
        setTimeout(function() { el.remove(); }, 250);
      }, 2800);
    }

    function openSheet(title, htmlContent) {
      document.getElementById("sheet-title").textContent = title;
      document.getElementById("sheet-body").innerHTML = htmlContent;
      document.getElementById("sheet-backdrop").classList.remove("hidden");
    }

    function closeSheet() {
      document.getElementById("sheet-backdrop").classList.add("hidden");
      document.getElementById("sheet-body").innerHTML = "";
    }

    function showConfirm(title, message, onConfirm) {
      const backdrop = document.getElementById("confirm-backdrop");
      document.getElementById("confirm-title").textContent = title;
      document.getElementById("confirm-message").textContent = message;
      backdrop.classList.remove("hidden");
      const okBtn = document.getElementById("confirm-ok-btn");
      const cancelBtn = document.getElementById("confirm-cancel-btn");
      const cleanup = function() {
        backdrop.classList.add("hidden");
        okBtn.onclick = null;
        cancelBtn.onclick = null;
      };
      cancelBtn.onclick = cleanup;
      okBtn.onclick = function() {
        cleanup();
        if (typeof onConfirm === "function") onConfirm();
      };
    }

