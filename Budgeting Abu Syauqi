    function onTxJenisChange(txPreset) {
      const checked = document.querySelector('#form-transaksi input[name="jenis"]:checked');
      if (!checked) return;
      const jenis = checked.value;
      const katWrap = document.getElementById("tx-kat-wrapper");
      const posWrap = document.getElementById("tx-pos-wrapper");
      const dstWrap = document.getElementById("tx-dompet-tujuan-wrap");
      const srcLabel = document.getElementById("tx-dompet-label");

      if (jenis === "Transfer") {
        katWrap.classList.add("hidden");
        dstWrap.classList.remove("hidden");
        srcLabel.textContent = "Dompet Asal";
        return;
      }

      katWrap.classList.remove("hidden");
      dstWrap.classList.add("hidden");
      srcLabel.textContent = "Dompet / Rekening";
      posWrap.classList.toggle("hidden", jenis !== "Pengeluaran");

      const listKat = state.data.kategori.filter(function(k) { return k.Jenis === jenis; });
      const uniqueMain = Array.from(new Set(listKat.map(function(k) { return k.Kategori_Utama; })));
      const mainSel = document.getElementById("tx-kat-utama");
      mainSel.innerHTML = uniqueMain.map(function(m) {
        return '<option value="' + escapeHtml(m) + '">' + escapeHtml(m) + '</option>';
      }).join("");

      if (txPreset && txPreset.Kategori_Utama && uniqueMain.indexOf(txPreset.Kategori_Utama) >= 0) {
        mainSel.value = txPreset.Kategori_Utama;
      }
      onTxMainCatChange(txPreset);
    }

    function onTxMainCatChange(txPreset) {
      const checked = document.querySelector('#form-transaksi input[name="jenis"]:checked');
      if (!checked || checked.value === "Transfer") return;
      const jenis = checked.value;
      const mainCat = document.getElementById("tx-kat-utama").value;
      const subs = state.data.kategori.filter(function(k) {
        return k.Jenis === jenis && k.Kategori_Utama === mainCat;
      });
      const subSel = document.getElementById("tx-sub-kat");
      subSel.innerHTML = subs.map(function(s) {
        return '<option value="' + escapeHtml(s.Sub_Kategori) + '">' + escapeHtml(s.Sub_Kategori) + '</option>';
      }).join("");

      if (txPreset && txPreset.Sub_Kategori) {
        subSel.value = txPreset.Sub_Kategori;
      }
      onTxSubCatChange(txPreset);
    }

    function onTxSubCatChange(txPreset) {
      const checked = document.querySelector('#form-transaksi input[name="jenis"]:checked');
      if (!checked || checked.value !== "Pengeluaran") return;
      const mainCat = document.getElementById("tx-kat-utama").value;
      const subCat = document.getElementById("tx-sub-kat").value;
      const found = state.data.kategori.find(function(k) {
        return k.Jenis === "Pengeluaran" && k.Kategori_Utama === mainCat && k.Sub_Kategori === subCat;
      });
      const posSel = document.getElementById("tx-pos-budget");
      if (txPreset && txPreset.Pos_Budget && txPreset.Pos_Budget !== "-") {
        posSel.value = txPreset.Pos_Budget;
      } else if (found && found.Pos_Budget && found.Pos_Budget !== "-") {
        posSel.value = found.Pos_Budget;
      }
      updatePosBadgePreview();
    }

    function updatePosBadgePreview() {
      const posSel = document.getElementById("tx-pos-budget");
      const badge = document.getElementById("tx-pos-badge");
      if (!posSel || !badge) return;
      badge.textContent = posSel.value;
      badge.className = "text-[10px] font-extrabold px-2 py-0.5 rounded-md border " + getPosBadgeClass(posSel.value);
    }

    async function submitTransaksi(e, editId) {
      e.preventDefault();
      const jenis = document.querySelector('#form-transaksi input[name="jenis"]:checked').value;
      const dompetAsal = document.getElementById("tx-dompet").value;
      const dompetTujuan = jenis === "Transfer" ? document.getElementById("tx-dompet-tujuan").value : "";
      const nominalVal = parseNominal(document.getElementById("tx-nominal").value);
      if (nominalVal <= 0) {
        showToast("Nominal harus lebih dari 0", "warning");
        return;
      }
      if (jenis === "Transfer" && dompetAsal === dompetTujuan) {
        showToast("Dompet asal dan tujuan tidak boleh sama", "warning");
        return;
      }

      const payload = {
        ID_Transaksi: editId || undefined,
        Tanggal: document.getElementById("tx-tanggal").value,
        Jenis: jenis,
        Kategori_Utama: jenis === "Transfer" ? "Transfer" : document.getElementById("tx-kat-utama").value,
        Sub_Kategori: jenis === "Transfer" ? "Pindah Saldo" : document.getElementById("tx-sub-kat").value,
        Pos_Budget: jenis === "Pengeluaran" ? document.getElementById("tx-pos-budget").value : "-",
        ID_Dompet: dompetAsal,
        ID_Dompet_Tujuan: dompetTujuan,
        Nominal: nominalVal,
        Catatan: document.getElementById("tx-catatan").value.trim(),
        Dicatat_Oleh: "Keluarga Abu Syauqi"
      };

      const res = await apiCall("saveTransaction", payload);
      if (res.success) {
        closeSheet();
        showToast(editId ? "Transaksi diperbarui" : "Transaksi berhasil dicatat", "success");
        if (!IS_PREVIEW) await refreshAllData(true);
        else renderCurrentPage();
      }
    }

    function confirmDeleteTx(id) {
      showConfirm("Hapus Transaksi", "Data transaksi yang dihapus tidak dapat dikembalikan. Lanjutkan?", async function() {
        const res = await apiCall("deleteTransaction", { ID_Transaksi: id });
        if (res.success) {
          showToast("Transaksi dihapus", "info");
          if (!IS_PREVIEW) await refreshAllData(true);
          else renderCurrentPage();
        }
      });
    }

