              '</div>' +
            '</div>' +

            // Tabel Rencana VS Realita
            '<table class="w-full text-[10px]">' +
              '<thead><tr class="bg-slate-800 text-white">' +
                '<th class="py-1.5 px-2 text-left rounded-tl-lg">Pos</th>' +
                '<th class="py-1.5 px-2 text-right">Rencana</th>' +
                '<th class="py-1.5 px-2 text-right rounded-tr-lg">Realita</th>' +
              '</tr></thead>' +
              '<tbody>' +
                '<tr class="border-b border-slate-100"><td class="py-1.5 px-2 font-bold text-rose-700">' + pKeb + '% Kebutuhan</td><td class="py-1.5 px-2 text-right text-slate-600">' + formatRp(planKeb) + '</td><td class="py-1.5 px-2 text-right font-extrabold text-slate-900">' + formatRp(cur.posTotal.Kebutuhan) + '</td></tr>' +
                '<tr class="border-b border-slate-100"><td class="py-1.5 px-2 font-bold text-amber-700">' + pKei + '% Keinginan</td><td class="py-1.5 px-2 text-right text-slate-600">' + formatRp(planKei) + '</td><td class="py-1.5 px-2 text-right font-extrabold text-slate-900">' + formatRp(cur.posTotal.Keinginan) + '</td></tr>' +
                '<tr><td class="py-1.5 px-2 font-bold text-teal-700">' + pInv + '% Investasi</td><td class="py-1.5 px-2 text-right text-slate-600">' + formatRp(planInv) + '</td><td class="py-1.5 px-2 text-right font-extrabold text-slate-900">' + formatRp(cur.posTotal.Investasi) + '</td></tr>' +
              '</tbody>' +
            '</table>' +

            // Rincian Sub Kategori per Pos
            '<div>' +
              '<div class="grid grid-cols-3 gap-1 bg-slate-100 p-1 rounded-xl mb-2">' +
                '<button onclick="setDashTab(\'budget\',\'Kebutuhan\')" class="py-1.5 rounded-lg text-[10px] font-extrabold transition ' + (state.dashBudgetTab === 'Kebutuhan' ? 'bg-rose-600 text-white shadow-xs' : 'text-slate-600') + '">Kebutuhan</button>' +
                '<button onclick="setDashTab(\'budget\',\'Keinginan\')" class="py-1.5 rounded-lg text-[10px] font-extrabold transition ' + (state.dashBudgetTab === 'Keinginan' ? 'bg-amber-500 text-white shadow-xs' : 'text-slate-600') + '">Keinginan</button>' +
                '<button onclick="setDashTab(\'budget\',\'Investasi\')" class="py-1.5 rounded-lg text-[10px] font-extrabold transition ' + (state.dashBudgetTab === 'Investasi' ? 'bg-teal-600 text-white shadow-xs' : 'text-slate-600') + '">Investasi</button>' +
              '</div>' +
              '<div class="max-h-44 overflow-y-auto app-scroll">' +
                (posRowsHtml || '<p class="text-[11px] text-slate-400 text-center py-3">Belum ada transaksi di pos ini</p>') +
              '</div>' +
              '<div class="mt-2 pt-2 border-t border-slate-100 flex justify-between text-[11px] font-extrabold text-slate-800">' +
                '<span>Subtotal ' + state.dashBudgetTab + '</span><span>' + formatRp(activePosTotal) + '</span>' +
              '</div>' +
            '</div>' +
          '</div>' +

          // 8. KEUANGAN 6 BULAN TERAKHIR
          '<div class="bg-white rounded-2xl p-3.5 border border-slate-200/80 shadow-xs space-y-3">' +
            '<h2 class="text-xs font-extrabold text-slate-800 uppercase tracking-wide"><i class="fa-solid fa-calendar-days text-purple-600 mr-1.5"></i>Keuangan 6 Bulan Terakhir</h2>' +
            '<div class="h-44 relative"><canvas id="chart-last6"></canvas></div>' +
            '<div class="overflow-x-auto">' +
              '<table class="w-full text-[10px]">' +
                '<thead><tr class="bg-slate-100 text-slate-600">' +
                  '<th class="py-1.5 px-1.5 text-left rounded-tl-lg">Bulan</th>' +
                  '<th class="py-1.5 px-1 text-right text-teal-700">Masuk</th>' +
                  '<th class="py-1.5 px-1 text-right text-rose-600">Keluar</th>' +
                  '<th class="py-1.5 px-1 text-right text-purple-700">Saldo</th>' +
                  '<th class="py-1.5 px-1.5 text-right rounded-tr-lg">Tx</th>' +
                '</tr></thead>' +
                '<tbody>' +
                  last6.map(function(row) {
                    return '<tr class="border-b border-slate-100">' +
                      '<td class="py-1.5 px-1.5 font-bold text-slate-700 whitespace-nowrap">' + row.label + '</td>' +
                      '<td class="py-1.5 px-1 text-right font-semibold text-teal-700">' + formatShortRp(row.income) + '</td>' +
                      '<td class="py-1.5 px-1 text-right font-semibold text-rose-600">' + formatShortRp(row.expense) + '</td>' +
                      '<td class="py-1.5 px-1 text-right font-bold ' + (row.saldo >= 0 ? 'text-purple-700' : 'text-rose-600') + '">' + formatShortRp(row.saldo) + '</td>' +
                      '<td class="py-1.5 px-1.5 text-right text-slate-500">' + row.tx + '</td>' +
                    '</tr>';
                  }).join("") +
                  '<tr class="bg-slate-800 text-white font-extrabold">' +
                    '<td class="py-1.5 px-1.5 rounded-bl-lg">RATA-RATA</td>' +
                    '<td class="py-1.5 px-1 text-right">' + formatShortRp(avg6.income) + '</td>' +
                    '<td class="py-1.5 px-1 text-right">' + formatShortRp(avg6.expense) + '</td>' +
                    '<td class="py-1.5 px-1 text-right">' + formatShortRp(avg6.saldo) + '</td>' +
                    '<td class="py-1.5 px-1.5 text-right rounded-br-lg">' + avg6.tx + '</td>' +
                  '</tr>' +
                '</tbody>' +
              '</table>' +
            '</div>' +
          '</div>' +
        '</div>';

      // Render Charts Dashboard
      initDashboardCharts(cur, prev, last6, realKebPct, realKeiPct, realInvPct, pKeb, pKei, pInv);
    }

    function setDashTab(group, val) {
      if (group === "ex") state.dashExTab = val;
      if (group === "in") state.dashInTab = val;
      if (group === "budget") state.dashBudgetTab = val;
      renderCurrentPage();
    }

    function initDashboardCharts(cur, prev, last6, rKeb, rKei, rInv, pKeb, pKei, pInv) {
      // 1. Line Chart Pengeluaran Harian
      const dailyCtx = document.getElementById("chart-daily-expense");
      if (dailyCtx) {
        chartInstances.daily = new Chart(dailyCtx, {
          type: "line",
          data: {
            labels: cur.dailyExpense.map(function(_, i) { return String(i + 1); }),
            datasets: [{
              label: "Pengeluaran",
              data: cur.dailyExpense,
              borderColor: "#0f766e",
              backgroundColor: "rgba(15, 118, 110, 0.12)",
              borderWidth: 2,
              pointRadius: 2.5,
              pointBackgroundColor: "#0f766e",
              fill: true,
              tension: 0.35
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { grid: { display: false }, ticks: { font: { size: 9 } } },
              y: {
                beginAtZero: true,
                ticks: { font: { size: 9 }, callback: function(v) { return formatShortRp(v); } }
              }
            }
          }
        });
      }

      // 2. Donut Alokasi Kategori Pengeluaran (jika tab alokasi aktif)
      const exDonutCtx = document.getElementById("chart-ex-donut");
      if (exDonutCtx && cur.topExMain.length > 0) {
        const palette = ["#e11d48", "#f97316", "#eab308", "#0d9488", "#0284c7", "#6366f1", "#a855f7", "#ec4899", "#64748b", "#14b8a6"];
        chartInstances.exDonut = new Chart(exDonutCtx, {
          type: "doughnut",
          data: {
            labels: cur.topExMain.map(function(x) { return x.name; }),
            datasets: [{
              data: cur.topExMain.map(function(x) { return x.total; }),
              backgroundColor: palette,
              borderWidth: 2,
              borderColor: "#ffffff"
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: "60%",
            plugins: {
              legend: { position: "right", labels: { boxWidth: 10, font: { size: 9 } } }
            }
          }
        });
      }

      // 3. Donut Kategori Pemasukan
      const inDonutCtx = document.getElementById("chart-in-donut");
      if (inDonutCtx && cur.topInMain.length > 0) {
        chartInstances.inDonut = new Chart(inDonutCtx, {
          type: "doughnut",
          data: {
            labels: cur.topInMain.map(function(x) { return x.name; }),
            datasets: [{
              data: cur.topInMain.map(function(x) { return x.total; }),
              backgroundColor: ["#0f766e", "#f97316", "#0284c7", "#8b5cf6"],
              borderWidth: 2,
              borderColor: "#ffffff"
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: "62%",
            plugins: {
              legend: { position: "right", labels: { boxWidth: 10, font: { size: 9 } } }
            }
          }
        });
      }

      // 4. Bar Chart Perbandingan Pemasukan Bulan Ini vs Bulan Lalu
      const inCompCtx = document.getElementById("chart-in-compare");
      if (inCompCtx) {
        const allInMain = Array.from(new Set(
          cur.topInMain.map(function(x) { return x.name; }).concat(prev.topInMain.map(function(x) { return x.name; }))
        ));
        const getVal = function(arr, name) {
          const found = arr.find(function(x) { return x.name === name; });
          return found ? found.total : 0;
        };
        chartInstances.inComp = new Chart(inCompCtx, {
          type: "bar",
          data: {
            labels: allInMain.map(function(s) { return s.length > 14 ? s.slice(0, 14) + ".." : s; }),
            datasets: [
              { label: "Bulan Ini", data: allInMain.map(function(n) { return getVal(cur.topInMain, n); }), backgroundColor: "#0f766e", borderRadius: 6 },
              { label: "Bulan Lalu", data: allInMain.map(function(n) { return getVal(prev.topInMain, n); }), backgroundColor: "#94a3b8", borderRadius: 6 }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { boxWidth: 10, font: { size: 10 } } } },
            scales: {
              x: { grid: { display: false }, ticks: { font: { size: 9 } } },
              y: { beginAtZero: true, ticks: { font: { size: 9 }, callback: function(v) { return formatShortRp(v); } } }
            }
          }
        });
      }

      // 5. Tiga Ring Charts 50/30/20
      const makeRing = function(canvasId, key, val, target, color, bg) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        const filled = Math.min(val, target);
        const rem = Math.max(0, target - filled);
        chartInstances[key] = new Chart(ctx, {
          type: "doughnut",
          data: {
            datasets: [{
              data: [filled, rem > 0 ? rem : (filled === 0 ? 1 : 0)],
              backgroundColor: [color, bg],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: "72%",
            plugins: { legend: { display: false }, tooltip: { enabled: false } }
          }
        });
      };
      makeRing("chart-ring-keb", "ringKeb", rKeb, pKeb, "#e11d48", "#ffe4e6");
      makeRing("chart-ring-kei", "ringKei", rKei, pKei, "#f59e0b", "#fef3c7");
      makeRing("chart-ring-inv", "ringInv", rInv, pInv, "#0d9488", "#ccfbf1");

      // 6. Bar Chart 6 Bulan Terakhir
      const last6Ctx = document.getElementById("chart-last6");
      if (last6Ctx) {
        const rev = last6.slice().reverse();
        chartInstances.last6 = new Chart(last6Ctx, {
          type: "bar",
          data: {
            labels: rev.map(function(x) { return x.label.split(" ")[0]; }),
            datasets: [
              { label: "Masuk", data: rev.map(function(x) { return x.income; }), backgroundColor: "#0f766e", borderRadius: 4 },
              { label: "Keluar", data: rev.map(function(x) { return x.expense; }), backgroundColor: "#e11d48", borderRadius: 4 },
              { label: "Saldo", data: rev.map(function(x) { return x.saldo; }), backgroundColor: "#7e22ce", borderRadius: 4 }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { boxWidth: 9, font: { size: 9 } } } },
            scales: {
              x: { grid: { display: false }, ticks: { font: { size: 9 } } },
              y: { ticks: { font: { size: 9 }, callback: function(v) { return formatShortRp(v); } } }
            }
          }
        });
      }
    }

    // =========================================================================
    // 8. HALAMAN TRANSAKSI & BOTTOM SHEET INPUT BERTINGKAT
    // =========================================================================
    function renderTransaksiPage(container) {
      const monthTx = getTransactionsByPeriod(state.selectedYear, state.selectedMonth);
      const q = state.txSearch.toLowerCase();
      const filtered = monthTx.filter(function(tx) {
        if (state.txJenis !== "ALL" && tx.Jenis !== state.txJenis) return false;
        if (state.txDompet !== "ALL" && tx.ID_Dompet !== state.txDompet && tx.ID_Dompet_Tujuan !== state.txDompet) return false;
        if (q) {
          const hay = (tx.Sub_Kategori + " " + tx.Kategori_Utama + " " + tx.Catatan + " " + getWalletName(tx.ID_Dompet)).toLowerCase();
          if (hay.indexOf(q) === -1) return false;
        }
        return true;
      }).sort(function(a, b) {
        return String(b.Tanggal).localeCompare(String(a.Tanggal));
      });

      const listHtml = filtered.map(function(tx) {
        const isIn = tx.Jenis === "Pemasukan";
        const isTr = tx.Jenis === "Transfer";
        const iconBg = isIn ? "bg-teal-100 text-teal-700" : (isTr ? "bg-sky-100 text-sky-700" : "bg-rose-100 text-rose-600");
        const iconFa = isIn ? "fa-arrow-down" : (isTr ? "fa-right-left" : "fa-arrow-up");
        const nomClass = isIn ? "text-teal-700" : (isTr ? "text-sky-700" : "text-rose-600");
        const sign = isIn ? "+" : (isTr ? "" : "-");
        const walletInfo = isTr
          ? getWalletName(tx.ID_Dompet) + " -> " + getWalletName(tx.ID_Dompet_Tujuan)
          : getWalletName(tx.ID_Dompet);

        return '<div class="bg-white rounded-2xl p-3 border border-slate-200/80 shadow-2xs flex items-start gap-3">' +
          '<div class="w-10 h-10 rounded-xl ' + iconBg + ' flex items-center justify-center shrink-0 mt-0.5">' +
            '<i class="fa-solid ' + iconFa + ' text-sm"></i>' +
          '</div>' +
          '<div class="flex-1 min-w-0">' +
            '<div class="flex items-start justify-between gap-2">' +
              '<p class="text-xs font-extrabold text-slate-900 truncate">' + escapeHtml(tx.Sub_Kategori) + '</p>' +
              '<p class="text-xs font-extrabold ' + nomClass + ' whitespace-nowrap">' + sign + formatRp(tx.Nominal) + '</p>' +
            '</div>' +
            '<div class="flex items-center flex-wrap gap-1.5 mt-0.5">' +
              '<span class="text-[10px] font-semibold text-slate-500">' + escapeHtml(tx.Kategori_Utama) + '</span>' +
              (tx.Jenis === "Pengeluaran" ? '<span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded-md border ' + getPosBadgeClass(tx.Pos_Budget) + '">' + escapeHtml(tx.Pos_Budget) + '</span>' : '') +
            '</div>' +
            (tx.Catatan ? '<p class="text-[11px] text-slate-500 mt-1 line-clamp-1">' + escapeHtml(tx.Catatan) + '</p>' : '') +
            '<div class="flex items-center justify-between mt-2 pt-1.5 border-t border-slate-100">' +
              '<span class="text-[10px] font-semibold text-slate-400"><i class="fa-regular fa-calendar mr-1"></i>' + formatDateIndo(tx.Tanggal) + ' &bull; ' + escapeHtml(walletInfo) + '</span>' +
              '<div class="flex items-center gap-1.5">' +
                '<button onclick="openTransaksiSheet(\'' + tx.ID_Transaksi + '\')" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 hover:text-teal-700 flex items-center justify-center"><i class="fa-solid fa-pen text-[10px]"></i></button>' +
                '<button onclick="confirmDeleteTx(\'' + tx.ID_Transaksi + '\')" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center"><i class="fa-solid fa-trash text-[10px]"></i></button>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>';
      }).join("");

      container.innerHTML =
        '<div class="space-y-3">' +
          '<div class="flex items-center justify-between">' +
            '<div><h2 class="text-base font-extrabold text-slate-900">Riwayat Transaksi</h2><p class="text-[11px] text-slate-500">' + filtered.length + ' transaksi ditampilkan</p></div>' +
            '<button onclick="openTransaksiSheet()" class="px-3.5 py-2 rounded-xl bg-teal-700 text-white text-xs font-extrabold shadow-sm active:scale-95 transition"><i class="fa-solid fa-plus mr-1"></i>Catat</button>' +
          '</div>' +

          // Filter Bar
          '<div class="bg-white rounded-2xl p-3 border border-slate-200/80 space-y-2">' +
            '<div class="relative">' +
              '<i class="fa-solid fa-magnifying-glass text-slate-400 text-xs absolute left-3 top-1/2 -translate-y-1/2"></i>' +
              '<input type="text" value="' + escapeHtml(state.txSearch) + '" oninput="state.txSearch=this.value;renderCurrentPage()" placeholder="Cari sub kategori, catatan, dompet..." class="w-full min-h-[38px] pl-8 pr-3 rounded-xl bg-slate-100 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-teal-500" />' +
