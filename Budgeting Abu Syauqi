            '<div class="flex items-center justify-between">' +
              '<h2 class="text-xs font-extrabold text-slate-800 uppercase tracking-wide"><i class="fa-solid fa-scale-balanced text-amber-500 mr-1.5"></i>Budgeting ' + pKeb + '/' + pKei + '/' + pInv + '</h2>' +
              '<button onclick="openTargetSheet()" class="text-[10px] font-extrabold text-teal-700 bg-teal-50 px-2.5 py-1 rounded-lg">Atur Target</button>' +
            '</div>' +

            // % Budget yang digunakan
            '<div class="bg-slate-50 rounded-xl p-2.5 border border-slate-200/70">' +
              '<div class="flex justify-between text-[11px] font-extrabold mb-1">' +
                '<span class="text-slate-600">% Budget yang Digunakan</span>' +
                '<span class="' + (pctUsed > 100 ? 'text-rose-600' : 'text-teal-700') + '">' + pctUsed + '%</span>' +
