            '<form onsubmit="submitTargetForm(event, \'' + key + '\', false)" class="space-y-3">' +
              '<div>' +
                '<label class="block text-[11px] font-bold text-slate-600 mb-1">Target Pengeluaran Bulanan (Rp)</label>' +
                '<input type="text" inputmode="numeric" id="ang-target-nom" required oninput="formatNominalInput(this)" value="' + formatNumberComma(targetNom) + '" placeholder="10,000,000" class="w-full min-h-[42px] px-3 rounded-xl border border-slate-200 text-sm font-extrabold" />' +
              '</div>' +
              '<div class="grid grid-cols-3 gap-2">' +
                '<div><label class="block text-[10px] font-bold text-rose-700 mb-1">Kebutuhan (%)</label><input type="number" id="ang-pkeb" value="' + pKeb + '" min="0" max="100" class="w-full min-h-[40px] px-2.5 rounded-xl border border-slate-200 text-xs font-extrabold text-center" /></div>' +
                '<div><label class="block text-[10px] font-bold text-amber-700 mb-1">Keinginan (%)</label><input type="number" id="ang-pkei" value="' + pKei + '" min="0" max="100" class="w-full min-h-[40px] px-2.5 rounded-xl border border-slate-200 text-xs font-extrabold text-center" /></div>' +
                '<div><label class="block text-[10px] font-bold text-teal-700 mb-1">Investasi (%)</label><input type="number" id="ang-pinv" value="' + pInv + '" min="0" max="100" class="w-full min-h-[40px] px-2.5 rounded-xl border border-slate-200 text-xs font-extrabold text-center" /></div>' +
              '</div>' +
              '<button type="submit" class="w-full min-h-[44px] rounded-xl bg-teal-700 text-white text-xs font-extrabold shadow-sm active:scale-[0.98] transition">Simpan Target Anggaran</button>' +
            '</form>' +
          '</div>' +

          '<div class="space-y-2.5">' +
            items.map(function(it) {
              const limit = Math.round(targetNom * (it.pct / 100));
              const usedPct = limit > 0 ? Math.round((it.real / limit) * 100) : 0;
              const over = limit > 0 && it.real > limit;
              return '<div class="bg-white rounded-2xl p-3.5 border border-slate-200/80 shadow-xs">' +
                '<div class="flex items-center justify-between mb-1.5">' +
                  '<span class="text-xs font-extrabold ' + it.text + '">' + it.name + ' (' + it.pct + '%)</span>' +
                  '<span class="text-[11px] font-extrabold ' + (over ? 'text-rose-600' : 'text-slate-700') + '">' + usedPct + '% terpakai</span>' +
                '</div>' +
                '<div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden mb-2">' +
                  '<div class="h-full ' + (over ? 'bg-rose-600' : it.color) + ' rounded-full" style="width:' + Math.min(100, usedPct) + '%"></div>' +
                '</div>' +
                '<div class="flex justify-between text-[11px] text-slate-500">' +
                  '<span>Realisasi: <b class="text-slate-900">' + formatRp(it.real) + '</b></span>' +
                  '<span>Batas: <b class="text-slate-800">' + formatRp(limit) + '</b></span>' +
                '</div>' +
              '</div>';
            }).join("") +
          '</div>' +
        '</div>';
    }

