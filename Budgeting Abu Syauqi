      const cur = computeMonthMetrics(state.selectedYear, state.selectedMonth);
      const targetNom = t ? (Number(t.Target_Pengeluaran) || 0) : 0;
      const pKeb = t ? (Number(t.Persen_Kebutuhan) || 50) : 50;
      const pKei = t ? (Number(t.Persen_Keinginan) || 30) : 30;
      const pInv = t ? (Number(t.Persen_Investasi) || 20) : 20;

      const items = [
        { name: "Kebutuhan", pct: pKeb, real: cur.posTotal.Kebutuhan, color: "bg-rose-500", text: "text-rose-700" },
        { name: "Keinginan", pct: pKei, real: cur.posTotal.Keinginan, color: "bg-amber-500", text: "text-amber-700" },
