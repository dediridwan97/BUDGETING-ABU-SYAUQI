    function ensureDefaultCategories(katList) {
      const list = Array.isArray(katList) ? katList.slice() : [];
      const defaults = getDefaultMasterKategori();
      let changed = false;
      defaults.forEach(function(def) {
        const exists = list.some(function(k) {
          return String(k.Jenis).toLowerCase() === String(def.Jenis).toLowerCase() &&
                 String(k.Kategori_Utama).toLowerCase() === String(def.Kategori_Utama).toLowerCase() &&
                 String(k.Sub_Kategori).toLowerCase() === String(def.Sub_Kategori).toLowerCase();
        });
        if (!exists) {
          list.push(def);
          changed = true;
        }
      });
      return { list: list, changed: changed };
    }

    function savePreviewDB() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state.data));
      } catch (e) {}
    }

    function loadPreviewDB() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.kategori)) {
            const merged = ensureDefaultCategories(parsed.kategori);
            parsed.kategori = merged.list;
            if (merged.changed) {
              try { localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed)); } catch (e) {}
            }
            return parsed;
          }
        }
      } catch (e) {}
      const fresh = buildDummyData();
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(fresh)); } catch (e) {}
      return fresh;
    }

    async function apiCall(action, payload) {
      const body = payload || {};
      if (IS_PREVIEW) {
        return handlePreviewApi(action, body);
      }

      showLoader(true);
      try {
        const res = await fetch(GAS_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ action: action, payload: body })
        });
        const json = await res.json();
        showLoader(false);
        if (!json.success) {
          showToast(json.message || "Terjadi kesalahan di server", "error");
        }
        return json;
      } catch (err) {
        showLoader(false);
        showToast("Gagal terhubung ke Google Sheets: " + err.message, "error");
        return { success: false, message: err.message };
      }
    }

    function handlePreviewApi(action, p) {
      if (action === "getAllData") {
        const db = loadPreviewDB();
        return { success: true, data: db };
      }
      if (action === "saveTransaction") {
        if (p.ID_Transaksi) {
          const idx = state.data.transaksi.findIndex(function(x) { return x.ID_Transaksi === p.ID_Transaksi; });
          if (idx >= 0) state.data.transaksi[idx] = Object.assign({}, state.data.transaksi[idx], p);
        } else {
          p.ID_Transaksi = genId("TX");
          p.Created_At = new Date().toISOString();
          state.data.transaksi.unshift(p);
        }
        savePreviewDB();
        return { success: true, data: p };
      }
      if (action === "deleteTransaction") {
        state.data.transaksi = state.data.transaksi.filter(function(x) { return x.ID_Transaksi !== p.ID_Transaksi; });
        savePreviewDB();
        return { success: true };
      }
      if (action === "saveBudgetTarget") {
        const idx = state.data.targetBulanan.findIndex(function(x) { return x.Bulan_Tahun === p.Bulan_Tahun; });
        if (idx >= 0) {
          state.data.targetBulanan[idx] = Object.assign({}, state.data.targetBulanan[idx], p);
        } else {
          p.ID_Target_Bln = "TB-" + p.Bulan_Tahun;
          state.data.targetBulanan.push(p);
        }
        savePreviewDB();
        return { success: true, data: p };
      }
      if (action === "saveWallet") {
        if (p.ID_Dompet) {
          const idx = state.data.dompet.findIndex(function(x) { return x.ID_Dompet === p.ID_Dompet; });
          if (idx >= 0) state.data.dompet[idx] = Object.assign({}, state.data.dompet[idx], p);
        } else {
          p.ID_Dompet = genId("DMP");
          state.data.dompet.push(p);
