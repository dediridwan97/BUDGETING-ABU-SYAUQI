            // 3 Ring Charts
            '<div class="grid grid-cols-3 gap-2 text-center">' +
              '<div class="bg-rose-50/70 rounded-xl p-2 border border-rose-100">' +
                '<div class="h-16 relative mx-auto"><canvas id="chart-ring-keb"></canvas></div>' +
                '<p class="text-[10px] font-extrabold text-rose-700 mt-1">' + realKebPct + '% / ' + pKeb + '%</p>' +
                '<p class="text-[9px] font-bold text-slate-500 uppercase">Kebutuhan</p>' +
              '</div>' +
              '<div class="bg-amber-50/70 rounded-xl p-2 border border-amber-100">' +
                '<div class="h-16 relative mx-auto"><canvas id="chart-ring-kei"></canvas></div>' +
                '<p class="text-[10px] font-extrabold text-amber-700 mt-1">' + realKeiPct + '% / ' + pKei + '%</p>' +
                '<p class="text-[9px] font-bold text-slate-500 uppercase">Keinginan</p>' +
              '</div>' +
              '<div class="bg-teal-50/70 rounded-xl p-2 border border-teal-100">' +
                '<div class="h-16 relative mx-auto"><canvas id="chart-ring-inv"></canvas></div>' +
                '<p class="text-[10px] font-extrabold text-teal-700 mt-1">' + realInvPct + '% / ' + pInv + '%</p>' +
