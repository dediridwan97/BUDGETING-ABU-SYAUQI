              '<button onclick="setDashTab(\'ex\',\'alokasi\')" class="py-1.5 rounded-lg text-[10px] font-extrabold transition ' + (state.dashExTab === 'alokasi' ? 'bg-white text-rose-600 shadow-xs' : 'text-slate-500') + '">Alokasi</button>' +
              '<button onclick="setDashTab(\'ex\',\'compare\')" class="py-1.5 rounded-lg text-[10px] font-extrabold transition ' + (state.dashExTab === 'compare' ? 'bg-white text-rose-600 shadow-xs' : 'text-slate-500') + '">VS Bln Lalu</button>' +
