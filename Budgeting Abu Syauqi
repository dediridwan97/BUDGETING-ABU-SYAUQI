    function getTransactionsByPeriod(year, monthIdx) {
      const prefix = getBulanTahunKey(year, monthIdx);
      return state.data.transaksi.filter(function(tx) {
        return String(tx.Tanggal || "").startsWith(prefix);
      });
    }

    function getTargetBulanan(year, monthIdx) {
      const key = getBulanTahunKey(year, monthIdx);
      return state.data.targetBulanan.find(function(t) { return t.Bulan_Tahun === key; }) || null;
    }

    function getWalletName(id) {
      const w = state.data.dompet.find(function(x) { return x.ID_Dompet === id; });
      return w ? w.Nama_Dompet : "-";
    }

    function getWalletBalance(id) {
      const w = state.data.dompet.find(function(x) { return x.ID_Dompet === id; });
      let bal = w ? (Number(w.Saldo_Awal) || 0) : 0;
      state.data.transaksi.forEach(function(tx) {
        const nom = Number(tx.Nominal) || 0;
        if (tx.Jenis === "Pemasukan" && tx.ID_Dompet === id) bal += nom;
        if (tx.Jenis === "Pengeluaran" && tx.ID_Dompet === id) bal -= nom;
        if (tx.Jenis === "Transfer") {
          if (tx.ID_Dompet === id) bal -= nom;
          if (tx.ID_Dompet_Tujuan === id) bal += nom;
        }
      });
      return bal;
    }

    function computeMonthMetrics(year, monthIdx) {
      const list = getTransactionsByPeriod(year, monthIdx);
      let income = 0, expense = 0, inCount = 0, exCount = 0;
      const exBySub = {};
      const exByMain = {};
      const inBySub = {};
      const inByMain = {};
      const posMap = { Kebutuhan: {}, Keinginan: {}, Investasi: {} };
      const posTotal = { Kebutuhan: 0, Keinginan: 0, Investasi: 0 };

      const daysInMonth = new Date(year, monthIdx + 1, 0).getDate();
      const dailyExpense = new Array(daysInMonth).fill(0);

      list.forEach(function(tx) {
        const nom = Number(tx.Nominal) || 0;
        if (tx.Jenis === "Pemasukan") {
          income += nom;
          inCount++;
          inBySub[tx.Sub_Kategori] = (inBySub[tx.Sub_Kategori] || 0) + nom;
          inByMain[tx.Kategori_Utama] = (inByMain[tx.Kategori_Utama] || 0) + nom;
        } else if (tx.Jenis === "Pengeluaran") {
          expense += nom;
          exCount++;
          exBySub[tx.Sub_Kategori] = (exBySub[tx.Sub_Kategori] || 0) + nom;
          exByMain[tx.Kategori_Utama] = (exByMain[tx.Kategori_Utama] || 0) + nom;
          const pos = (tx.Pos_Budget === "Kebutuhan" || tx.Pos_Budget === "Keinginan" || tx.Pos_Budget === "Investasi")
            ? tx.Pos_Budget
            : "Kebutuhan";
          posMap[pos][tx.Sub_Kategori] = (posMap[pos][tx.Sub_Kategori] || 0) + nom;
          posTotal[pos] += nom;

          const dayNum = Number(String(tx.Tanggal).split("-")[2]);
          if (dayNum >= 1 && dayNum <= daysInMonth) {
            dailyExpense[dayNum - 1] += nom;
          }
        }
      });

      const sortObj = function(obj) {
        return Object.entries(obj)
          .map(function(e) { return { name: e[0], total: e[1] }; })
          .sort(function(a, b) { return b.total - a.total; });
      };

      return {
        list: list,
        income: income,
        expense: expense,
        saldo: income - expense,
        totalTx: list.length,
        inCount: inCount,
        exCount: exCount,
        topExSub: sortObj(exBySub),
        topExMain: sortObj(exByMain),
        topInSub: sortObj(inBySub),
        topInMain: sortObj(inByMain),
        exBySubMap: exBySub,
        inBySubMap: inBySub,
        posList: {
          Kebutuhan: sortObj(posMap.Kebutuhan),
          Keinginan: sortObj(posMap.Keinginan),
          Investasi: sortObj(posMap.Investasi)
        },
        posTotal: posTotal,
        dailyExpense: dailyExpense,
        daysInMonth: daysInMonth
      };
    }

    function pctChangeText(curr, prev) {
      if (prev === 0 && curr === 0) return "0% vs bln lalu";
      if (prev === 0) return "+100% vs bln lalu";
      const diff = ((curr - prev) / Math.abs(prev)) * 100;
      const sign = diff > 0 ? "+" : "";
      return sign + diff.toFixed(1) + "% vs bln lalu";
    }

