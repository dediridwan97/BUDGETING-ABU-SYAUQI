    async function submitTargetForm(e, key, fromSheet) {
      e.preventDefault();
      const nom = parseNominal(document.getElementById("ang-target-nom").value);
      const pkeb = Number(document.getElementById("ang-pkeb").value) || 0;
      const pkei = Number(document.getElementById("ang-pkei").value) || 0;
      const pinv = Number(document.getElementById("ang-pinv").value) || 0;
      if (pkeb + pkei + pinv !== 100) {
        showToast("Total persentase Kebutuhan + Keinginan + Investasi harus 100%", "warning");
        return;
      }
      const res = await apiCall("saveBudgetTarget", {
        Bulan_Tahun: key,
        Target_Pengeluaran: nom,
        Persen_Kebutuhan: pkeb,
        Persen_Keinginan: pkei,
        Persen_Investasi: pinv
      });
      if (res.success) {
        if (fromSheet) closeSheet();
        showToast("Target anggaran berhasil disimpan", "success");
        if (!IS_PREVIEW) await refreshAllData(true);
        else renderCurrentPage();
      }
    }

