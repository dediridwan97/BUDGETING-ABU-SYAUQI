                return '<div class="flex items-center justify-between text-[11px] py-1.5 border-b border-slate-100 last:border-0">' +
                  '<div class="min-w-0 pr-2"><p class="font-bold text-slate-800 truncate">' + escapeHtml(tx.Sub_Kategori) + '</p><p class="text-[10px] text-slate-400">' + formatDateIndo(tx.Tanggal) + ' • ' + escapeHtml(tx.Kategori_Utama) + '</p></div>' +
                  '<span class="font-extrabold whitespace-nowrap ' + (tx.Jenis === 'Pemasukan' ? 'text-teal-700' : 'text-rose-600') + '">' + formatRp(tx.Nominal) + '</span>' +
                '</div>';
              }).join("") +
            '</div>' +
          '</div>' +
        '</div>';
    }

    function exportMonthlyCSV() {
      const list = getTransactionsByPeriod(state.selectedYear, state.selectedMonth);
      if (list.length === 0) {
        showToast("Tidak ada transaksi untuk diekspor", "warning");
        return;
      }
      const header = ["Tanggal", "Jenis", "Kategori Utama", "Sub Kategori", "Pos Budget", "Dompet", "Nominal", "Catatan"];
      const rows = list.map(function(tx) {
        return [
          tx.Tanggal, tx.Jenis, tx.Kategori_Utama, tx.Sub_Kategori,
          tx.Pos_Budget, getWalletName(tx.ID_Dompet), tx.Nominal, tx.Catatan || ""
        ].map(function(v) { return '"' + String(v).replace(/"/g, '""') + '"'; }).join(",");
      });
      const csv = "\uFEFF" + header.join(",") + "\n" + rows.join("\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "Abu_Syauqi_Budgeting_" + getBulanTahunKey(state.selectedYear, state.selectedMonth) + ".csv";
      a.click();
      URL.revokeObjectURL(url);
      showToast("File CSV berhasil diunduh", "success");
    }

    // --- PENGATURAN MASTER KATEGORI (79 KATEGORI BERKELOMPOK) ---
    function renderPengaturanPage(container) {
      const exCount = state.data.kategori.filter(function(k) { return k.Jenis === "Pengeluaran"; }).length;
      const inCount = state.data.kategori.filter(function(k) { return k.Jenis === "Pemasukan"; }).length;
      const q = state.katSearch.toLowerCase();

      const filtered = state.data.kategori.filter(function(k) {
        if (k.Jenis !== state.katTab) return false;
        if (q && (k.Kategori_Utama + " " + k.Sub_Kategori + " " + k.Pos_Budget).toLowerCase().indexOf(q) === -1) return false;
        return true;
      });

      const grouped = {};
      filtered.forEach(function(k) {
        if (!grouped[k.Kategori_Utama]) grouped[k.Kategori_Utama] = [];
        grouped[k.Kategori_Utama].push(k);
      });

      const groupsHtml = Object.keys(grouped).map(function(mainName) {
        const items = grouped[mainName];
        const isClosed = !!state.katCollapsed[mainName];
        return '<div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-2xs">' +
          '<button onclick="toggleKatGroup(\'' + escapeHtml(mainName).replace(/'/g, "\\'") + '\')" class="w-full px-3.5 py-2.5 bg-slate-50/80 flex items-center justify-between text-left">' +
            '<span class="text-xs font-extrabold text-slate-800">' + escapeHtml(mainName) + ' <span class="text-slate-400 font-bold">(' + items.length + ')</span></span>' +
            '<i class="fa-solid ' + (isClosed ? 'fa-chevron-down' : 'fa-chevron-up') + ' text-[10px] text-slate-400"></i>' +
          '</button>' +
          (isClosed ? '' :
            '<div class="divide-y divide-slate-100 px-3.5">' +
              items.map(function(k) {
                return '<div class="py-2 flex items-center justify-between gap-2">' +
                  '<div class="min-w-0">' +
                    '<p class="text-xs font-semibold text-slate-800 truncate">' + escapeHtml(k.Sub_Kategori) + '</p>' +
                    (k.Jenis === "Pengeluaran" ? '<span class="inline-block mt-0.5 text-[9px] font-extrabold px-1.5 py-0.5 rounded-md border ' + getPosBadgeClass(k.Pos_Budget) + '">' + escapeHtml(k.Pos_Budget) + '</span>' : '') +
                  '</div>' +
                  '<button onclick="confirmDeleteKat(\'' + k.ID_Kategori + '\')" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-500 flex items-center justify-center shrink-0"><i class="fa-solid fa-trash text-[10px]"></i></button>' +
                '</div>';
              }).join("") +
            '</div>'
          ) +
        '</div>';
      }).join("");

      container.innerHTML =
        subPageHeader("Master Kategori", "Kategori", "openKategoriSheet()") +
        '<div class="space-y-3">' +
          '<div class="grid grid-cols-2 gap-1.5 bg-slate-200/70 p-1 rounded-xl">' +
            '<button onclick="state.katTab=\'Pengeluaran\';renderCurrentPage()" class="py-2 rounded-lg text-xs font-extrabold transition ' + (state.katTab === "Pengeluaran" ? 'bg-white text-rose-600 shadow-xs' : 'text-slate-600') + '">Pengeluaran (' + exCount + ')</button>' +
            '<button onclick="state.katTab=\'Pemasukan\';renderCurrentPage()" class="py-2 rounded-lg text-xs font-extrabold transition ' + (state.katTab === "Pemasukan" ? 'bg-white text-teal-700 shadow-xs' : 'text-slate-600') + '">Pemasukan (' + inCount + ')</button>' +
          '</div>' +
          '<input type="text" value="' + escapeHtml(state.katSearch) + '" oninput="state.katSearch=this.value;renderCurrentPage()" placeholder="Cari kategori atau sub kategori..." class="w-full min-h-[40px] px-3.5 rounded-xl bg-white border border-slate-200 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-teal-500" />' +
          '<div class="space-y-2.5">' + (groupsHtml || '<p class="text-xs text-slate-400 text-center py-6">Kategori tidak ditemukan</p>') + '</div>' +
        '</div>';
    }

    function toggleKatGroup(name) {
      state.katCollapsed[name] = !state.katCollapsed[name];
      renderCurrentPage();
    }

    function openKategoriSheet() {
      const mainSuggestions = Array.from(new Set(state.data.kategori.map(function(k) { return k.Kategori_Utama; })));
      openSheet("Tambah Sub Kategori",
        '<form onsubmit="submitKategori(event)" class="space-y-3">' +
          '<div><label class="block text-[11px] font-bold text-slate-600 mb-1">Jenis</label><select id="kat-jenis" onchange="document.getElementById(\'kat-pos-row\').classList.toggle(\'hidden\', this.value!==\'Pengeluaran\')" class="w-full min-h-[42px] px-3 rounded-xl border border-slate-200 text-xs font-bold bg-white"><option value="Pengeluaran">Pengeluaran</option><option value="Pemasukan">Pemasukan</option></select></div>' +
          '<div><label class="block text-[11px] font-bold text-slate-600 mb-1">Kategori Utama</label><input type="text" id="kat-main" list="main-cat-suggestions" required placeholder="Contoh: Kebutuhan Rumah Tangga" class="w-full min-h-[42px] px-3 rounded-xl border border-slate-200 text-xs font-bold" /><datalist id="main-cat-suggestions">' +
            mainSuggestions.map(function(m) { return '<option value="' + escapeHtml(m) + '"></option>'; }).join("") +
          '</datalist></div>' +
          '<div><label class="block text-[11px] font-bold text-slate-600 mb-1">Sub Kategori</label><input type="text" id="kat-sub" required placeholder="Contoh: Service AC" class="w-full min-h-[42px] px-3 rounded-xl border border-slate-200 text-xs font-bold" /></div>' +
          '<div id="kat-pos-row"><label class="block text-[11px] font-bold text-slate-600 mb-1">Pos Budgeting 50/30/20</label><select id="kat-pos" class="w-full min-h-[42px] px-3 rounded-xl border border-slate-200 text-xs font-bold bg-white"><option value="Kebutuhan">Kebutuhan (50%)</option><option value="Keinginan">Keinginan (30%)</option><option value="Investasi">Investasi (20%)</option></select></div>' +
          '<button type="submit" class="w-full min-h-[46px] rounded-xl bg-teal-700 text-white text-sm font-extrabold">Simpan Kategori</button>' +
        '</form>'
      );
    }

    async function submitKategori(e) {
      e.preventDefault();
      const jenis = document.getElementById("kat-jenis").value;
      const res = await apiCall("saveCategory", {
        Jenis: jenis,
        Kategori_Utama: document.getElementById("kat-main").value.trim(),
        Sub_Kategori: document.getElementById("kat-sub").value.trim(),
        Pos_Budget: jenis === "Pengeluaran" ? document.getElementById("kat-pos").value : "-"
      });
      if (res.success) {
        closeSheet();
        showToast("Kategori ditambahkan", "success");
        if (!IS_PREVIEW) await refreshAllData(true);
        else renderCurrentPage();
      }
    }

    function confirmDeleteKat(id) {
      showConfirm("Hapus Kategori", "Yakin ingin menghapus sub kategori ini?", async function() {
        const res = await apiCall("deleteCategory", { ID_Kategori: id });
        if (res.success) {
          showToast("Kategori dihapus", "info");
          if (!IS_PREVIEW) await refreshAllData(true);
          else renderCurrentPage();
        }
      });
    }

    // =========================================================================
    // 11. INISIALISASI APLIKASI
    // =========================================================================
    // 11. FITUR PWA AUTO-INSTALL KE HP (MANIFEST, SERVICE WORKER & PROMPT)
    // =========================================================================
    let deferredInstallPrompt = null;
    const PWA_DISMISS_KEY = "abu_syauqi_pwa_dismissed";

    function isRunningStandalone() {
      return (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches) ||
        window.navigator.standalone === true;
    }

    function isIosDevice() {
      return /iphone|ipad|ipod/i.test(window.navigator.userAgent || "");
    }

    function initPwaManifest() {
      try {
        const startUrl = window.location.origin + window.location.pathname;
        const manifest = {
          name: "Abu Syauqi Budgeting",
          short_name: "Abu Syauqi",
          description: "Aplikasi pencatatan keuangan & budgeting 50/30/20 keluarga modern",
          start_url: startUrl,
          scope: window.location.origin + "/",
          display: "standalone",
          orientation: "portrait",
          background_color: "#f8fafc",
          theme_color: "#0f766e",
          icons: [
            {
              src: "https://placehold.co/192x192/0f766e/ffffff.png?text=AS",
              sizes: "192x192",
              type: "image/png",
              purpose: "any maskable"
            },
            {
              src: "https://placehold.co/512x512/0f766e/ffffff.png?text=AS",
              sizes: "512x512",
              type: "image/png",
              purpose: "any maskable"
            }
          ]
        };
        const blob = new Blob([JSON.stringify(manifest)], { type: "application/manifest+json" });
        const manifestUrl = URL.createObjectURL(blob);
        const linkEl = document.getElementById("pwa-manifest-link");
        if (linkEl) linkEl.setAttribute("href", manifestUrl);
      } catch (e) {}
    }

    function registerPwaServiceWorker() {
      try {
        if ("serviceWorker" in navigator && (window.location.protocol === "https:" || window.location.hostname === "localhost")) {
          navigator.serviceWorker.register("./sw.js").catch(function() {});
        }
      } catch (e) {}
    }

    function showPwaInstallUI(showBanner) {
      if (isRunningStandalone()) return;
      const topBtn = document.getElementById("btn-install-top");
      const banner = document.getElementById("pwa-install-banner");
      if (topBtn) {
        topBtn.classList.remove("hidden");
        topBtn.classList.add("flex");
      }
      if (banner && showBanner && !sessionStorage.getItem(PWA_DISMISS_KEY)) {
        banner.classList.remove("hidden");
      }
    }

    function hidePwaInstallUI() {
      const topBtn = document.getElementById("btn-install-top");
      const banner = document.getElementById("pwa-install-banner");
      if (topBtn) {
        topBtn.classList.add("hidden");
        topBtn.classList.remove("flex");
      }
      if (banner) banner.classList.add("hidden");
    }

    function dismissPwaBanner() {
      const banner = document.getElementById("pwa-install-banner");
      if (banner) banner.classList.add("hidden");
      try { sessionStorage.setItem(PWA_DISMISS_KEY, "1"); } catch (e) {}
    }

    async function triggerPwaInstall() {
      if (isRunningStandalone()) {
        showToast("Aplikasi sudah terpasang di HP Anda", "info");
        return;
      }

      // 1. Jika browser mendukung popup install otomatis (Android Chrome/Edge/Samsung)
      if (deferredInstallPrompt) {
        try {
          deferredInstallPrompt.prompt();
          const choice = await deferredInstallPrompt.userChoice;
          if (choice && choice.outcome === "accepted") {
            showToast("Memasang aplikasi ke HP...", "success");
            hidePwaInstallUI();
          }
          deferredInstallPrompt = null;
          return;
        } catch (err) {}
      }

      // 2. Panduan cepat untuk pengguna iPhone / iPad (Safari)
      if (isIosDevice()) {
        openSheet("Pasang di Layar Utama iPhone",
          '<div class="space-y-3.5 text-xs text-slate-700">' +
            '<p class="leading-relaxed">Safari iPhone memerlukan 3 ketukan singkat untuk memasang aplikasi ke layar utama:</p>' +
            '<div class="space-y-2.5">' +
              '<div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">' +
                '<span class="w-7 h-7 rounded-lg bg-teal-700 text-white font-extrabold flex items-center justify-center shrink-0">1</span>' +
                '<p>Ketuk ikon <b>Share</b> (<i class="fa-solid fa-arrow-up-from-bracket text-teal-700"></i>) di bagian bawah Safari.</p>' +
              '</div>' +
              '<div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">' +
                '<span class="w-7 h-7 rounded-lg bg-teal-700 text-white font-extrabold flex items-center justify-center shrink-0">2</span>' +
                '<p>Gulir ke bawah lalu pilih <b>Add to Home Screen</b> (Tambahkan ke Layar Utama).</p>' +
              '</div>' +
              '<div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">' +
                '<span class="w-7 h-7 rounded-lg bg-teal-700 text-white font-extrabold flex items-center justify-center shrink-0">3</span>' +
                '<p>Ketuk <b>Add / Tambah</b> di pojok kanan atas.</p>' +
              '</div>' +
            '</div>' +
            '<button onclick="closeSheet()" class="w-full min-h-[44px] rounded-xl bg-teal-700 text-white font-extrabold">Mengerti</button>' +
          '</div>'
        );
        return;
      }

      // 3. Panduan fallback jika dibuka di Preview atau browser belum memicu prompt otomatis
      openSheet("Cara Install ke HP (Android)",
        '<div class="space-y-3.5 text-xs text-slate-700">' +
          '<p class="leading-relaxed">Popup install otomatis aktif saat aplikasi dibuka lewat URL <b>HTTPS Vercel</b> di Chrome HP. Anda juga bisa memasangnya manual dengan cara:</p>' +
          '<div class="space-y-2.5">' +
            '<div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">' +
              '<span class="w-7 h-7 rounded-lg bg-teal-700 text-white font-extrabold flex items-center justify-center shrink-0">1</span>' +
              '<p>Buka link aplikasi Vercel Anda menggunakan browser <b>Google Chrome</b>.</p>' +
            '</div>' +
            '<div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">' +
              '<span class="w-7 h-7 rounded-lg bg-teal-700 text-white font-extrabold flex items-center justify-center shrink-0">2</span>' +
              '<p>Ketuk ikon titik tiga (<b>⋮</b>) di pojok kanan atas browser.</p>' +
            '</div>' +
            '<div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">' +
              '<span class="w-7 h-7 rounded-lg bg-teal-700 text-white font-extrabold flex items-center justify-center shrink-0">3</span>' +
              '<p>Pilih <b>Install app</b> atau <b>Tambahkan ke layar utama</b>.</p>' +
            '</div>' +
          '</div>' +
          '<button onclick="closeSheet()" class="w-full min-h-[44px] rounded-xl bg-teal-700 text-white font-extrabold">Tutup</button>' +
        '</div>'
      );
    }

    function initPwaInstaller() {
      initPwaManifest();
      registerPwaServiceWorker();

      if (isRunningStandalone()) {
        hidePwaInstallUI();
        return;
      }

      // Tangkap event native install otomatis di Android Chrome / Edge
      window.addEventListener("beforeinstallprompt", function(e) {
        e.preventDefault();
        deferredInstallPrompt = e;
        showPwaInstallUI(true);
      });

      window.addEventListener("appinstalled", function() {
        deferredInstallPrompt = null;
        hidePwaInstallUI();
        showToast("Aplikasi berhasil dipasang di HP Anda!", "success");
      });

      // Tampilkan tombol Install di header & banner lembut untuk iPhone/mobile
      setTimeout(function() {
        if (!isRunningStandalone()) {
          showPwaInstallUI(isIosDevice() || Boolean(deferredInstallPrompt));
        }
      }, 1500);
    }

    // =========================================================================
    // 12. INISIALISASI APLIKASI
    // =========================================================================
    async function refreshAllData(silent) {
      const res = await apiCall("getAllData");
      if (res.success && res.data) {
        const mergedKat = ensureDefaultCategories(res.data.kategori);
        state.data = {
          dompet: res.data.dompet || [],
          kategori: mergedKat.list,
          transaksi: res.data.transaksi || [],
          targetBulanan: res.data.targetBulanan || [],
          targetTabungan: res.data.targetTabungan || [],
          tagihan: res.data.tagihan || []
        };
        renderTopBar();
        renderBottomNav();
        renderCurrentPage();
        if (!silent) showToast("Data berhasil disegarkan", "info");
      }
    }

    window.addEventListener("DOMContentLoaded", function() {
      initPwaInstaller();
      renderTopBar();
      renderBottomNav();
      refreshAllData(true);
    });
  </script>
</body>
